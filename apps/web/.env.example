# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI Orchestration (FastAPI service, see services/ai-orchestrator) ---
AI_ORCHESTRATOR_URL=http://localhost:8000
