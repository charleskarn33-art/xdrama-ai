# Copy to .env for local development. Never commit .env.

ENVIRONMENT=development

SUPABASE_URL=http://localhost:54321
# Project Settings > API > JWT Secret. Must match the frontend's Supabase project.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Project Settings > API > service_role key. Bypasses RLS — never expose to
# a browser. Used only by authorized actions (e.g. AI Model Manager installs)
# after this service independently verifies the caller is a platform admin.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Project Settings > API > anon/public key. Same value the frontend uses —
# scopes per-request clients to the calling user's own RLS grants.
SUPABASE_ANON_KEY=your-supabase-anon-key

REDIS_URL=redis://localhost:6379/0

RENDER_NODE_URLS=

# GPU compute backend for render dispatch (app/core/compute/). "modal" is
# the only implementation. Get these from modal.com > Settings > API Tokens.
AI_COMPUTE_PROVIDER=modal
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret

CORS_ALLOW_ORIGINS=http://localhost:3000
